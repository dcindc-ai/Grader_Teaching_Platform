ANTHROPIC_API_KEY=sk-ant-your-key-here
# Anthropic model for all grading/AI calls.
# Leave UNSET to auto-select the newest claude-opus-* model at startup (recommended).
# Set it to pin a specific model instead — e.g. ANTHROPIC_MODEL=claude-sonnet-4-6 for lower cost.
# ANTHROPIC_MODEL=
ADMIN_PASSWORD=your-password-here
GITHUB_TOKEN=your-github-token-here
GITHUB_REPO=dcindc-ai/Grader_Teaching_Platform
PORT=3001
NODE_ENV=development

# Set to false to skip the login screen entirely (recommended for local use)
REQUIRE_PASSWORD=true
